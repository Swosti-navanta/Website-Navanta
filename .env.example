# Transactional email for demo requests (/api/demo), sent via Resend.
#
# Create a key at resend.com → API Keys (sending access is enough), then add it
# to Vercel → Settings → Environment Variables. The sending domain
# (navanta.ai) must be verified in Resend first or every send is rejected.
#
# Without this the route still stores the lead but returns a 500, and the user
# is told to email info@navanta.ai directly.
RESEND_API_KEY=

# Sender + internal recipient for demo requests. Both have defaults in code, so
# these are only needed to override them.
#
# Before navanta.ai is verified in Resend, the sandbox sender is the only one
# that works — and it can ONLY deliver to the Resend account owner's address:
#   DEMO_MAIL_FROM=Navanta <onboarding@resend.dev>
#
# After verifying the domain, switch to your own:
#   DEMO_MAIL_FROM=Navanta <demo@navanta.ai>
DEMO_MAIL_FROM=
DEMO_MAIL_TO=

# Feedback widget shared store (Vercel KV / Upstash Redis).
# Also used by /api/demo to persist leads and rate-limit submissions.
#
# Create a KV / Upstash Redis store in the Vercel dashboard (Storage → create →
# connect to this project). That injects these vars into the deployment.
# Locally, run `vercel env pull` to fetch them into .env.local.
#
# Without these, the /api/feedback route falls back to a per-process in-memory
# store (fine for local dev, NOT shared across users or durable in production).
#
# Either the Vercel KV pair …
KV_REST_API_URL=
KV_REST_API_TOKEN=
# … or the Upstash marketplace pair (the route accepts either):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
